rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() {
   return request.auth != null;
  }
  function isParent() {
   return signedIn()
    && exists(/databases/$(database)/documents/parentProfiles/$(request.auth.uid))
    && get(/databases/$(database)/documents/parentProfiles/$(request.auth.uid)).data.role == "PARENT"
    && get(/databases/$(database)/documents/parentProfiles/$(request.auth.uid)).data.status == "active";
  }
  function adminPath() {
   return /databases/$(database)/documents/platformAdmins/$(request.auth.uid);
  }
  function isSuperAdmin() {
   return signedIn() && exists(adminPath())
    && get(adminPath()).data.role == "GI_SUPER_ADMIN"
    && get(adminPath()).data.status == "active";
  }
  function hmPath() {
   return /databases/$(database)/documents/headMasters/$(request.auth.uid);
  }
  function isActiveHeadMasterFor(schoolId) {
   return signedIn() && exists(hmPath())
    && get(hmPath()).data.role == "HEAD_MASTER"
    && get(hmPath()).data.status == "active"
    && get(hmPath()).data.schoolId == schoolId;
  }
  function isActiveHeadMaster() {
   return signedIn() && exists(adminPath())
    && get(adminPath()).data.role == "HEAD_MASTER"
    && get(adminPath()).data.status == "active";
  }
  function isActiveHeadMasterForSchool(schoolId) {
   return isActiveHeadMaster() && get(adminPath()).data.schoolId == schoolId;
  }
  function linkedParent(studentRecordId) {
   return isParent()
    && exists(/databases/$(database)/documents/parentLinks/$(studentRecordId + "_" + request.auth.uid))
    && get(/databases/$(database)/documents/parentLinks/$(studentRecordId + "_" + request.auth.uid)).data.parentUid == request.auth.uid;
  }
  function linkedStudent(studentRecordId) {
   return signedIn()
    && exists(/databases/$(database)/documents/students/$(studentRecordId))
    && get(/databases/$(database)/documents/students/$(studentRecordId)).data.authUid == request.auth.uid
    && get(/databases/$(database)/documents/students/$(studentRecordId)).data.status == "active";
  }

  match /platformAdmins/{adminUid} {
   allow get: if signedIn() && request.auth.uid == adminUid;
   allow list, create, update, delete: if false;
  }
  match /schools/{schoolId} {
   allow read, write: if isSuperAdmin();
   allow get: if isActiveHeadMasterFor(schoolId);
   allow list: if false;
  }
  match /headMasters/{headMasterUid} {
   allow read: if isSuperAdmin() || (signedIn() && request.auth.uid == headMasterUid);
   allow write: if isSuperAdmin();
  }
  match /adminAudit/{auditId} {
   allow read, write: if isSuperAdmin();
  }

  // Existing Teacher rules are preserved.
  match /teachers/{teacherId} {
   allow get: if isActiveHeadMaster() || (signedIn() && resource.data.authUid == request.auth.uid && resource.data.status == "active");
   allow list: if isActiveHeadMaster();
   allow create: if isActiveHeadMaster()
    && request.resource.data.teacherId == teacherId
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.status == "active"
    && request.resource.data.authUid == null;
   allow update: if isActiveHeadMaster()
    && request.resource.data.teacherId == resource.data.teacherId
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if false;
  }
  match /teacherCounters/{counterId} {
   allow read, write: if isActiveHeadMaster();
  }
  match /teacherAccessAttempts/{attemptId} {
   allow read, write: if false;
  }

  // Head Master class and student records are isolated by school.
  match /classrooms/{classroomId} {
   allow get: if isActiveHeadMaster()
    && (!exists(/databases/$(database)/documents/classrooms/$(classroomId)) || isActiveHeadMasterForSchool(resource.data.schoolId));
   allow list: if isActiveHeadMasterForSchool(resource.data.schoolId);
   allow create: if isActiveHeadMasterForSchool(request.resource.data.schoolId);
   allow update: if isActiveHeadMasterForSchool(resource.data.schoolId)
    && request.resource.data.schoolId == resource.data.schoolId;
   allow delete: if false;
  }
  match /studentCounters/{counterId} {
   allow get: if isActiveHeadMaster()
    && (!exists(/databases/$(database)/documents/studentCounters/$(counterId)) || isActiveHeadMasterForSchool(resource.data.schoolId));
   allow list: if false;
   allow create: if isActiveHeadMasterForSchool(request.resource.data.schoolId);
   allow update: if isActiveHeadMasterForSchool(resource.data.schoolId)
    && request.resource.data.schoolId == resource.data.schoolId;
   allow delete: if false;
  }
  match /students/{studentRecordId} {
   allow get: if isActiveHeadMasterForSchool(resource.data.schoolId) || linkedParent(studentRecordId) || linkedStudent(studentRecordId);
   allow list: if isActiveHeadMasterForSchool(resource.data.schoolId);
   allow create: if isActiveHeadMasterForSchool(request.resource.data.schoolId)
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.studentRecordId == studentRecordId
    && request.resource.data.status == "active";
   allow update: if isActiveHeadMasterForSchool(resource.data.schoolId)
    && request.resource.data.schoolId == resource.data.schoolId
    && request.resource.data.studentRecordId == resource.data.studentRecordId;
   allow delete: if false;
  }
  match /studentSecrets/{studentRecordId} {
   allow get, list: if isActiveHeadMasterForSchool(resource.data.schoolId);
   allow create: if isActiveHeadMasterForSchool(request.resource.data.schoolId);
   allow update: if isActiveHeadMasterForSchool(resource.data.schoolId)
    && request.resource.data.schoolId == resource.data.schoolId;
   allow delete: if isActiveHeadMasterForSchool(resource.data.schoolId);
  }
  // A Parent may resolve a known Student ID, but this lookup has no name, DOB or Secret Code.
  match /studentLookup/{studentId} {
   allow get: if isParent() || linkedStudent(resource.data.studentRecordId) || (isActiveHeadMaster() && (!exists(/databases/$(database)/documents/studentLookup/$(studentId)) || isActiveHeadMasterForSchool(resource.data.schoolId)));
   allow list: if false;
   allow create: if isActiveHeadMasterForSchool(request.resource.data.schoolId);
   allow update: if isActiveHeadMasterForSchool(resource.data.schoolId)
    && request.resource.data.schoolId == resource.data.schoolId;
   allow delete: if isActiveHeadMasterForSchool(resource.data.schoolId);
  }
  match /parentProfiles/{uid} {
   allow get: if (signedIn() && request.auth.uid == uid) || (isActiveHeadMaster() && isActiveHeadMasterForSchool(resource.data.schoolId));
   allow list: if isActiveHeadMasterForSchool(resource.data.schoolId);
   allow create, update: if isActiveHeadMasterForSchool(request.resource.data.schoolId)
    && request.resource.data.uid == uid
    && request.resource.data.role == "PARENT"
    && request.resource.data.status == "active"
    && request.resource.data.mobile is string;
   allow delete: if false;
  }
  match /parentClaims/{claimId} {
   allow create: if isParent()
    && claimId == request.auth.uid + "_" + request.resource.data.studentRecordId
    && request.resource.data.parentUid == request.auth.uid
    && exists(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId))
    && exists(/databases/$(database)/documents/studentSecrets/$(request.resource.data.studentRecordId))
    && get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.status == "active"
    && get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.schoolId == get(/databases/$(database)/documents/parentProfiles/$(request.auth.uid)).data.schoolId
    && get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.parentMobile == get(/databases/$(database)/documents/parentProfiles/$(request.auth.uid)).data.mobile
    && request.resource.data.studentId == get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.studentId
    && request.resource.data.dob == get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.dob
    && request.resource.data.secretCodeHash == get(/databases/$(database)/documents/studentSecrets/$(request.resource.data.studentRecordId)).data.secretCodeHash;
   allow read, update, delete: if false;
  }
  match /parentLinks/{linkId} {
   allow get, list: if isActiveHeadMasterForSchool(resource.data.schoolId)
    || (isParent() && resource.data.parentUid == request.auth.uid);
   allow create: if isParent()
    && linkId == request.resource.data.studentRecordId + "_" + request.auth.uid
    && request.resource.data.parentUid == request.auth.uid
    && request.resource.data.relationship in ["Father", "Mother", "Guardian", "Other"]
    && request.resource.data.schoolId == get(/databases/$(database)/documents/students/$(request.resource.data.studentRecordId)).data.schoolId
    && existsAfter(/databases/$(database)/documents/parentClaims/$(request.auth.uid + "_" + request.resource.data.studentRecordId))
    && getAfter(/databases/$(database)/documents/parentClaims/$(request.auth.uid + "_" + request.resource.data.studentRecordId)).data.parentUid == request.auth.uid;
   allow update: if false;
   allow delete: if isActiveHeadMasterForSchool(resource.data.schoolId);
  }

  match /{document=**} {
   allow read, write: if false;
  }
 }
}